# production 배포용 .env 템플릿.
#
# 이 파일을 EC2의 /opt/waitforddaman/.env로 복사한 뒤 <> 로 표시된 값을 채운다.
# .env는 gitignore되어 커밋되지 않는다 - 실제 시크릿을 이 파일에 적지 말 것.
#
# 이 브랜치(production)에는 로컬 개발용 compose/Dockerfile이 없어서 이 템플릿도
# 프로덕션 기준이다. 로컬 개발은 develop / develop-services 브랜치에서 한다.
#
# ⚠️ 파일 권한: Airflow 컨테이너가 uid 50000 / gid 0으로 돌면서 이 파일을
# /opt/airflow/ingestion/.env로 마운트해 직접 source한다. chmod 600으로 두면
# 컨테이너가 못 읽어서 모든 DAG 태스크가 "Permission denied"로 실패한다.
#     sudo chown ec2-user:root .env && chmod 640 .env

# ---- 실행 환경 ----
# aws: 실제 S3 사용 (local은 LocalStack - 이 브랜치에서는 쓰지 않는다)
APP_ENV=aws

# Iceberg 카탈로그. Glue 권한이 없어 hadoop(S3 객체 스토리지 기반)으로 고정한다.
ICEBERG_CATALOG_TYPE=hadoop
ICEBERG_CATALOG_NAME=bike_catalog

# ---- Spark 실행 튜닝 ----
# 별도 Spark 클러스터 없이 Airflow 컨테이너 안에서 PySpark가 돌기 때문에 true로
# 강제해야 한다. 지정하지 않으면 APP_ENV=aws일 때 기본값이 false로 떨어져
# 아래 튜닝이 전부 빠지고, 대용량 CSV(반기 파일 ~700MB) 처리 중 OOM이 난다.
SPARK_LOCAL_EXECUTION=true

# EC2가 t4g.large(2vCPU/8GB)라 코드 기본값(local[2] / 6g)보다 낮춰 잡는다.
# 실측 후 조정할 값 - 여유가 생기면 driver memory부터 올린다.
SPARK_LOCAL_MASTER=local[2]
SPARK_LOCAL_DRIVER_MEMORY=3g
SPARK_LOCAL_SHUFFLE_PARTITIONS=8

# ---- AWS / S3 ----
# 정적 AWS 키(AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)는 설정하지 않는다.
# EC2 인스턴스 프로파일 IAM Role로 인증한다 - 빈 문자열조차 주면 자격증명
# 체인을 방해할 수 있다. S3_ENDPOINT도 LocalStack 전용이라 설정하지 않는다.
AWS_DEFAULT_REGION=ap-northeast-2
RAW_BUCKET=<raw-bucket-name>
WAREHOUSE_BUCKET=<warehouse-bucket-name>
ICEBERG_WAREHOUSE_PATH=s3a://<warehouse-bucket-name>/warehouse

# ---- Airflow 메타데이터 DB (RDS) ----
AIRFLOW_DB_HOST=<airflow-metadata-db endpoint>.rds.amazonaws.com
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=<db-master-user>
AIRFLOW_DB_PASSWORD=<db-password>

# ---- 도메인/서빙 DB (RDS) : app / bikeman / serving 스키마 ----
# services/api의 DATABASE_URL이 이 값들로 조립된다(search_path=serving 포함).
DOMAIN_DB_HOST=<domain-db endpoint>.rds.amazonaws.com
DOMAIN_DB_PORT=5432
DOMAIN_DB_NAME=<domain-db-name>
DOMAIN_DB_USER=<db-master-user>
DOMAIN_DB_PASSWORD=<db-password>

# ---- serving 스키마 쓰기 (pipeline/serving_sync) ----
# 위 DOMAIN_DB_*와 같은 DB를 가리켜야 한다. compose에서 조립하지 않고 여기 그대로
# 적는 이유: DAG가 `cd ingestion && source .env`로 이 파일을 직접 읽어 쓴다
# (serving_db.py가 os.environ["SERVING_DB_*"]를 요구).
SERVING_DB_HOST=<domain-db endpoint>.rds.amazonaws.com
SERVING_DB_PORT=5432
SERVING_DB_NAME=<domain-db-name>
SERVING_DB_USER=<db-master-user>
SERVING_DB_PASSWORD=<db-password>

# ---- bikeman 읽기 전용 (재배치 작업자 이벤트 원천) ----
# DOMAIN_DB와 같은 DB의 bikeman 스키마. 롤/스키마/시드는
# sql/bike_man/bikeman_seed_init.sql이 만든다(멱등적, 최초 1회 실행).
# 롤 비밀번호도 그 스크립트가 정하므로 값을 바꾸려면 양쪽을 함께 고쳐야 한다.
BIKEMAN_DB_HOST=<domain-db endpoint>.rds.amazonaws.com
BIKEMAN_DB_PORT=5432
BIKEMAN_DB_NAME=<domain-db-name>
BIKEMAN_DB_USER=airflow_reader
BIKEMAN_DB_PASSWORD=<seed 스크립트의 airflow_reader 비밀번호>

# ---- Airflow ----
# FERNET_KEY: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# JWT_SECRET : openssl rand -hex 32
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=<생성한 fernet key>
AIRFLOW__API_AUTH__JWT_SECRET=<생성한 jwt secret>
_AIRFLOW_WWW_USER_USERNAME=<웹 로그인 계정>
_AIRFLOW_WWW_USER_PASSWORD=<웹 로그인 비밀번호>
RISK_MODEL_CONFIG=/opt/airflow/pylib/config/risk_model.yaml

# ---- 서울 열린데이터광장 Open API ----
# 데이터셋 ID는 공개 식별자라 config/__init__.py의 기본값과 동일하다.
SEOUL_API_KEY=<data.seoul.go.kr 인증키>
SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_API_TYPE=json
API_PAGE_SIZE=1000
SEOUL_DATA_FILE_BASE_URL=https://datafile.seoul.go.kr/bigfile/iot/inf/nio_download.do
SEOUL_DATASET_ID_RENTAL_HISTORY=OA-15182
SEOUL_DATASET_ID_BREAKDOWN_REPORT=OA-15644
SEOUL_DATASET_ID_STATION_INFO=OA-13252

# ---- 워터마크 / 백필 ----
WATERMARK_KEY=_meta/watermark/rental_history.json
BACKFILL_START_DATE=2015-01-01

# ---- docker-compose.prod.yml 이미지 참조 ----
# IMAGE_TAG는 CD가 배포 시 커밋 SHA로 덮어쓴다(쉘 env가 .env보다 우선).
ECR_REGISTRY=<aws-account-id>.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=latest
