# 이 파일을 .env로 복사해서 실제 값을 채운다. .env는 gitignore되어 커밋되지 않는다.
# local(docker-compose.local.yml)과 prod(docker-compose.prod.yml)가 이 키들을 공유하되
# 값만 다르다 - 아래에 각각 표시.

# ---- 실행 환경 ----
# local: LocalStack S3 + Hadoop Iceberg Catalog / aws: 실제 S3 (config/__init__.py 참고)
APP_ENV=local

# ---- Spark 로컬 실행 튜닝 ----
# local 기본값 true. prod(t4g.large, 8GB)에서도 반드시 true로 강제해야 한다 -
# 안 그러면 APP_ENV=aws일 때 기본값이 false로 떨어져 OOM 방지 튜닝이 통째로 빠진다.
SPARK_LOCAL_EXECUTION=true

# ---- S3 / 객체 스토리지 ----
# local 전용 - prod에서는 이 두 값을 아예 설정하지 않는다(EC2 인스턴스 IAM Role로 인증)
S3_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-northeast-2

RAW_BUCKET=ttareungyi-raw
WAREHOUSE_BUCKET=ttareungyi-warehouse

# ---- Iceberg 카탈로그 ----
# prod도 hadoop으로 고정 (Glue 권한 없음 - 계정 SCP로 ECR 등 일부 서비스가 막혀있어
# Glue 권한 여부도 사전에 확인 필요)
ICEBERG_CATALOG_TYPE=hadoop
ICEBERG_CATALOG_NAME=bike_catalog
ICEBERG_WAREHOUSE_PATH=s3a://ttareungyi-warehouse/warehouse

# ---- Postgres (Airflow 메타DB + bikeman/serving 스키마) ----
# prod에서는 강력한 값으로 교체, 5432 포트를 host에 노출하지 않는다
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ---- Airflow ----
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ---- 서울 열린데이터광장 Open API ----
SEOUL_API_KEY=sample
SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_API_TYPE=json
API_PAGE_SIZE=1000
SEOUL_DATA_FILE_BASE_URL=https://datafile.seoul.go.kr/bigfile/iot/inf/nio_download.do
SEOUL_DATASET_ID_RENTAL_HISTORY=OA-15182
SEOUL_DATASET_ID_BREAKDOWN_REPORT=OA-15644
SEOUL_DATASET_ID_STATION_INFO=OA-13252

# ---- 워터마크 / 백필 ----
WATERMARK_KEY=_meta/watermark/rental_history.json
BACKFILL_START_DATE=2015-01-01

# ---- Bikeman 읽기 전용 DB (다른 서비스가 관리하는 별도 DB) ----
BIKEMAN_DB_HOST=
BIKEMAN_DB_PORT=5432
BIKEMAN_DB_NAME=
BIKEMAN_DB_USER=
BIKEMAN_DB_PASSWORD=
